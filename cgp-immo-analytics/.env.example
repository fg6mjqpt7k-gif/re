# =============================================================================
# CGP Immo Analytics — Variables d'environnement
# Copier ce fichier : cp .env.example .env
# Generer les secrets : openssl rand -hex 32
# =============================================================================

# --- Base de donnees ---
DB_PASSWORD=GENERATE_STRONG_PASSWORD_HERE

# --- Backend Auth ---
SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
REFRESH_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
ENVIRONMENT=development

# --- Claude API ---
CLAUDE_API_KEY=sk-ant-xxxx

# --- Frontend ---
API_URL=http://localhost:8000

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Production (a configurer quand tu as un domaine) ---
# DOMAIN=ton-domaine.fr
# API_URL=https://api.ton-domaine.fr
# CORS_ORIGINS=https://ton-domaine.fr,https://www.ton-domaine.fr
